{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Docker Compose Up",
            "type": "shell",
            "command": "docker compose up",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Docker Compose Down",
            "type": "shell",
            "command": "docker compose down",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Docker Compose Restart",
            "type": "shell",
            "command": "docker compose down && docker compose up",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Build Docker Image",
            "type": "shell",
            "command": "docker build -t agent-app .",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Build Docker Image With No Cache",
            "type": "shell",
            "command": "docker build --no-cache -t agent-app .",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}